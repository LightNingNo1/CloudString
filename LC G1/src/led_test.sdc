# ============================================================================
# led_test.sdc - LED 硬件自检顶层（led_test_top）专用时序约束（临时测试用）
# ----------------------------------------------------------------------------
# led_test_top 不含主设计的音频域同步器（mode_s/viben_s/depth_s/klv_s1/no_s0/
# adc_t1/aud_rst_sync）与 ADC 跨域寄存器（u_pitch/code_lat），主 SDC 中对应的
# set_false_path 目标全部不存在，会报 TA2003 阻断布线，故只保留主时钟约束。
# 用毕切回 LC G1.sdc 后重新布线即可恢复主设计时序约束。
# ============================================================================
create_clock -name clk -period 20.000 [get_ports {clk}]
